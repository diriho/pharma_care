# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Supabase project (Settings → API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# GitHub OAuth — configure the provider in Supabase Dashboard →
# Authentication → Providers → GitHub with the same client id/secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://<your-project-ref>.supabase.co/auth/v1/callback

